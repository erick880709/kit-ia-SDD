    "diagnostic": "resources/qa/",
    "coverage_plan": "resources/qa/",
    "report": "resources/qa/",
    "raw_results": "resources/qa/",
    "test_results": "resources/qa/",
    "manifest": "resources/qa/",
    "coverage_report": "resources/qa/",
    "evidence": "resources/qa/",
