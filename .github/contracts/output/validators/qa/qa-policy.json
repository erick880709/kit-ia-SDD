    "defaults": {
      "browser": [
        "video",
        "trace",
        "screenshot"
      ],
      "api": [
        "raw_results"
      ],
      "unit": [
        "raw_results"
      ]
    },
    "override": "Solo por instrucción explícita del encargo; registrar motivo. No reducir por defecto en CI."
  }
